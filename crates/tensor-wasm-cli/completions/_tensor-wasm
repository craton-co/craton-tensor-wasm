#compdef tensor-wasm

autoload -U is-at-least

_tensor-wasm() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" \
'--tenant=[Tenant id to advertise on outbound API requests]:TENANT: ' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_tensor-wasm_commands" \
"*::: :->tensor-wasm" \
&& ret=0
    case $state in
    (tensor-wasm)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:tensor-wasm-command-$line[1]:"
        case $line[1] in
            (run)
_arguments "${_arguments_options[@]}" \
'--export=[Name of the exported function to call]:EXPORT: ' \
'--args=[Arguments to pass to the export, encoded as a JSON array]:ARGS: ' \
'--tenant=[Tenant id]:TENANT: ' \
'-h[Print help]' \
'--help[Print help]' \
':file -- Path to the .wasm file to execute:_files' \
&& ret=0
;;
            (deploy)
_arguments "${_arguments_options[@]}" \
'--server=[Base URL of the target TensorWasm server]:SERVER: ' \
'--name=[Tenant-supplied display name]:NAME: ' \
'--tenant=[Tenant id]:TENANT: ' \
'-h[Print help]' \
'--help[Print help]' \
':file -- Path to the .wasm file to deploy:_files' \
&& ret=0
;;
            (invoke)
_arguments "${_arguments_options[@]}" \
'--server=[Base URL of the target TensorWasm server]:SERVER: ' \
'--args=[Arguments forwarded to the function, encoded as a JSON array]:ARGS: ' \
'--tenant=[Tenant id]:TENANT: ' \
'-h[Print help]' \
'--help[Print help]' \
':id -- Identifier of the deployed function to invoke:' \
&& ret=0
;;
            (bench)
_arguments "${_arguments_options[@]}" \
'--export=[Name of the export to call on each iteration]:EXPORT: ' \
'--n=[Number of iterations to run]:N: ' \
'--tenant=[Tenant id]:TENANT: ' \
'-h[Print help]' \
'--help[Print help]' \
':file -- Path to the .wasm file to benchmark:_files' \
&& ret=0
;;
            (snapshot)
_arguments "${_arguments_options[@]}" \
'--tenant=[Tenant id]:TENANT: ' \
'-h[Print help]' \
'--help[Print help]' \
":: :_tensor-wasm__snapshot_commands" \
"*::: :->snapshot" \
&& ret=0
case $state in
(snapshot)
    words=($line[1] "${words[@]}")
    (( CURRENT += 1 ))
    curcontext="${curcontext%:*:*}:tensor-wasm-snapshot-command-$line[1]:"
    case $line[1] in
        (save)
_arguments "${_arguments_options[@]}" \
'--instance=[Identifier of the running instance to snapshot]:INSTANCE: ' \
'--output=[Output path for the resulting .tensor-wasm archive]:OUTPUT:_files' \
'--server=[Base URL of the target TensorWasm server]:SERVER: ' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
        (restore)
_arguments "${_arguments_options[@]}" \
'--input=[Path to the .tensor-wasm archive to upload]:INPUT:_files' \
'--as-instance=[Identifier to assign to the restored instance]:AS_INSTANCE: ' \
'--server=[Base URL of the target TensorWasm server]:SERVER: ' \
'--max-decompressed=[Maximum decompressed snapshot size, in bytes]:MAX_DECOMPRESSED: ' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
    esac
;;
esac
;;
            (metrics)
_arguments "${_arguments_options[@]}" \
'--server=[Base URL of the target TensorWasm server]:SERVER: ' \
'--tenant=[Tenant id]:TENANT: ' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
            (observe)
_arguments "${_arguments_options[@]}" \
'--addr=[Base URL of the target TensorWasm server]:ADDR: ' \
'--interval=[Refresh interval, in seconds]:INTERVAL: ' \
'--tenant=[Tenant id]:TENANT: ' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
            (completions)
_arguments "${_arguments_options[@]}" \
'--out-dir=[Optional output directory]:OUT_DIR:_files -/' \
'--tenant=[Tenant id]:TENANT: ' \
'-h[Print help]' \
'--help[Print help]' \
':shell -- Target shell:(bash zsh fish powershell elvish)' \
&& ret=0
;;
            (man)
_arguments "${_arguments_options[@]}" \
'--out-dir=[Output directory for the per-subcommand .1 files]:OUT_DIR:_files -/' \
'--tenant=[Tenant id]:TENANT: ' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
        esac
    ;;
esac
}

(( $+functions[_tensor-wasm_commands] )) ||
_tensor-wasm_commands() {
    local commands; commands=(
'run:Run a Wasm module locally against the in-process TensorWasm engine' \
'deploy:Upload a Wasm module to a TensorWasm server' \
'invoke:Invoke a previously deployed function by id' \
'bench:Benchmark local invocation latency' \
'snapshot:Save or restore an instance snapshot' \
'metrics:Fetch and pretty-print Prometheus metrics from a TensorWasm server' \
'observe:Live operator dashboard over /healthz + /metrics' \
'completions:Emit shell completion scripts for the named shell' \
'man:Generate roff(7) man pages from the clap command tree' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'tensor-wasm commands' commands "$@"
}

(( $+functions[_tensor-wasm__snapshot_commands] )) ||
_tensor-wasm__snapshot_commands() {
    local commands; commands=(
'save:Capture the state of a running instance into a .tensor-wasm file via the API' \
'restore:Restore an instance from a .tensor-wasm archive via the API' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'tensor-wasm snapshot commands' commands "$@"
}

if [ "$funcstack[1]" = "_tensor-wasm" ]; then
    _tensor-wasm "$@"
else
    compdef _tensor-wasm tensor-wasm
fi
